  <bpmn:collaboration id="Collaboration_1ygoo3m">
    <bpmn:participant id="Participant_0q7ec2x" name="Sistema de Folha de Pagamento em Java (Back end)" processRef="Process_1xd67fa" />
    <bpmn:participant id="Participant_02qp19n" name="Sistema de Folha de Pagamento em Java (Consulta)" processRef="Process_1fm3fzu" />
    <bpmn:textAnnotation id="TextAnnotation_10hk5k4">
      <bpmn:text>Será necessário:
- ID;
- Nome completo;
- Tipo de colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0w5ubl0">
      <bpmn:text>1 - Padrão;
2 - Comissionado;
3 - Produção;
4 - Gere a folha de pagamento;
0 - Sair do programa.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_05gv8i6">
      <bpmn:text>1 - Padrão;
2 - Comissionado;
3 - Produção.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_05nitb1">
      <bpmn:text>O usuário deve informar o nome e a matrícula do colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1fwvzfj">
      <bpmn:text>O usuário deve informar o nome, matrícula, valor total das vendas e percentual da comissão do colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0gm1zdg">
      <bpmn:text>O usuário deve informar o nome, matrícula, quantidade de peças produzidas e o valor de cada peça produzida pelo colaborador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0kb02qi" associationDirection="None" sourceRef="Activity_0dmkmnu" targetRef="TextAnnotation_10hk5k4" />
    <bpmn:association id="Association_08zbdii" associationDirection="None" sourceRef="Activity_07r0el6" targetRef="TextAnnotation_05gv8i6" />
